{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binance-spot-scout",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "binance.myg2ray.top",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SCAN_CACHE",
      "id": "5401805e8e684cc6b7097555d626538d"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spot_scout_db",
      "database_id": "bc72522f-f58b-4b22-88af-5326d7e65a53",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "vars": {
    "ENABLE_DEBUG": "false",
    "STRATEGY_VERSION": "1.2.0"
  }
}
