# Cloudflare deployment (optional for local dev)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional: comma-separated Binance market-data hosts, tried in order.
# Leave unset to use the shipped list in src/config/api.ts.
# BINANCE_BASE_URLS=https://data-api.binance.vision,https://api.binance.com

# Local development flags
ENABLE_DEBUG=true
